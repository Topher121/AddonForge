{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AddonForge",
  "version": "0.3.0",
  "identifier": "com.pocketforgestudios.addonforge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AddonForge",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "additionalBrowserArgs": "--disable-gpu --in-process-gpu --renderer-process-limit=1 --enable-features=NetworkServiceInProcess2 --disable-extensions --disable-breakpad --disable-crash-reporter --no-first-run --disable-sync --disable-speech-api --disable-domain-reliability"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Pocket Forge Studios",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
