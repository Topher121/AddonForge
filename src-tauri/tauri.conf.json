{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AddonForge",
  "version": "0.1.0",
  "identifier": "com.pocketforgestudios.addonforge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AddonForge",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pocket Forge Studios",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
