{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AddonForge",
  "version": "0.2.0",
  "identifier": "com.pocketforgestudios.addonforge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AddonForge",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AudioServiceOutOfProcess,SpareRendererForSitePerProcess --enable-features=NetworkServiceInProcess2 --disable-gpu --in-process-gpu --renderer-process-limit=1 --disable-extensions --disable-background-networking --disable-component-update --disable-breakpad --disable-crash-reporter --no-first-run --disable-sync --disable-speech-api --disable-domain-reliability --disable-client-side-phishing-detection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pocket Forge Studios",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
